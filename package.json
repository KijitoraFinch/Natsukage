{
  "name": "natsukage",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "vendor:build": "bash scripts/build-tailscale-connect.sh",
    "vendor:rebuild": "bash scripts/build-tailscale-connect.sh --force",
