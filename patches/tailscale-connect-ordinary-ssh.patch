diff --git a/cmd/tsconnect/wasm/wasm_js.go b/cmd/tsconnect/wasm/wasm_js.go
index f58e420..d58b2a4 100644
--- a/cmd/tsconnect/wasm/wasm_js.go
+++ b/cmd/tsconnect/wasm/wasm_js.go
@@ -405,6 +405,42 @@ func (s *jsSSHSession) Run() {
 		onConnectionProgress.Invoke(message)
 	}
 
+	var auth []ssh.AuthMethod
+	if jsPrivateKey := s.termConfig.Get("privateKey"); jsPrivateKey.Type() == js.TypeString && jsPrivateKey.String() != "" {
+		privateKey := jsPrivateKey.String()
+		passphrase := ""
+		if jsPassphrase := s.termConfig.Get("privateKeyPassphrase"); jsPassphrase.Type() == js.TypeString {
+			passphrase = jsPassphrase.String()
+		}
+
+		var signer ssh.Signer
+		var err error
+		if passphrase == "" {
+			signer, err = ssh.ParsePrivateKey([]byte(privateKey))
+		} else {
+			signer, err = ssh.ParsePrivateKeyWithPassphrase([]byte(privateKey), []byte(passphrase))
+		}
+		if err != nil {
+			writeError("SSH Private Key", err)
+			return
+		}
+		auth = append(auth, ssh.PublicKeys(signer))
+	}
+	if jsPassword := s.termConfig.Get("password"); jsPassword.Type() == js.TypeString && jsPassword.String() != "" {
+		auth = append(auth, ssh.Password(jsPassword.String()))
+	}
+
+	// Credentials are never persisted. Clear the JavaScript references as soon
+	// as the Go SSH authentication methods have been constructed.
+	s.termConfig.Set("privateKey", "")
+	s.termConfig.Set("privateKeyPassphrase", "")
+	s.termConfig.Set("password", "")
+
+	if len(auth) == 0 {
+		writeError("SSH Authentication", fmt.Errorf("password or private key is required"))
+		return
+	}
+
 	ctx, cancel := context.WithTimeout(context.Background(), time.Duration(timeoutSeconds*float64(time.Second)))
 	defer cancel()
 	reportProgress(fmt.Sprintf("Connecting to %s…", strings.Split(s.host, ".")[0]))
@@ -417,12 +453,15 @@ func (s *jsSSHSession) Run() {
 
 	config := &ssh.ClientConfig{
 		HostKeyCallback: func(hostname string, remote net.Addr, key ssh.PublicKey) error {
-			// Host keys are not used with Tailscale SSH, but we can use this
-			// callback to know that the connection has been established.
+			// The outer Tailscale connection authenticates the destination
+			// node. Report the SSH fingerprint for visibility while trusting
+			// that Tailnet identity.
+			reportProgress(fmt.Sprintf("SSH host key %s", ssh.FingerprintSHA256(key)))
 			reportProgress("SSH connection established…")
 			return nil
 		},
 		User: s.username,
+		Auth: auth,
 	}
 
 	reportProgress("Starting SSH client…")
